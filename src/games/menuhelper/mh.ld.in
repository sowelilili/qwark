/*
 * A menu renderer's link map. build.sh puts the code cave's address in for
 * @TEXT_ORG@ and the data area's for @DATA_ORG@ and hands the result to
 * ppu-lv2-ld. The layout is the probes' and N0's, which ran on hardware:
 *
 *   code  at the code cave: the hook stubs, then the C. Only this part needs
 *         executable memory.
 *   data  at the data area, in the game's free read-write memory: the mailbox
 *         and the renderer state as they start (mh_<game>_state.S), read-only
 *         data, the renderer's own TOC (the stubs load _toc_base, the start of
 *         .toc plus 0x8000, which ppu-lv2-ld resolves TOC16 relocations against
 *         when there is no .got) and the descriptors of its functions, three of
 *         which the game calls (screen 36's start and stop, the callbacks).
 *
 * .data and .bss are placed only so build.sh can see them and refuse the build:
 * the renderer keeps no variables of its own. Its state is at an absolute
 * address, the start of the data image.
 */
OUTPUT_FORMAT("elf64-powerpc-celloslv2")
ENTRY(mh_frame_stub)

SECTIONS
{
	. = @TEXT_ORG@;
	.text : { *(.text.entry) *(.text) *(.text.*) }
	_text_end = .;

	. = @DATA_ORG@;
	.mh_state : { KEEP(*(.mh_state)) }
	.rodata : { *(.rodata) *(.rodata.*) *(.data.rel.ro*) }
	. = ALIGN(8);
	.toc : { *(.toc) *(.toc1) *(.got) }
	_toc_base = ADDR(.toc) + 0x8000;
	.opd : { *(.opd) }
	_data_end = .;

	.data : { *(.data) *(.data.*) *(.sdata) *(.sdata.*) }
	.bss : { *(.sbss) *(.sbss.*) *(.bss) *(.bss.*) *(COMMON) }

	/DISCARD/ : { *(.eh_frame) *(.comment) *(.note*) }
}
